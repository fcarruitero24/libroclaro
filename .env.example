# Copia este archivo a .env.local y completa lo que necesites. Nunca subas valores reales.
# Sin ninguna variable la app igual arranca: registro, panel, formulario público y hoja
# (los correos se escriben en la consola y los pagos quedan deshabilitados).

# --- Públicas (van en el build) ---
# URL pública de la app, sin barra final.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Supabase: URL y clave anon (públicas por diseño; la seguridad la da RLS). Tienen valor por defecto en src/lib/env.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile: clave de sitio. Sin ella no se muestra el widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# WhatsApp de soporte (solo dígitos, con código de país). Vacío = se oculta el botón.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Secretas (solo servidor; en producción, secretos del Worker) ---
# Supabase → Project Settings → API → service_role. Necesaria para webhooks, cron y avisos.
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare Turnstile: clave secreta para verificar en el servidor.
TURNSTILE_SECRET_KEY=
# Resend: correo transaccional.
RESEND_API_KEY=
EMAIL_FROM="LibroClaro <no-responder@tu-dominio.pe>"
# Correo que recibe los avisos internos (registros, suscripciones).
PLATFORM_EMAIL=
# Mercado Pago: token de la aplicación y clave(s) del webhook (varias separadas por coma).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Solo para pruebas con credenciales de prueba de Mercado Pago: correo del comprador de prueba.
MP_TEST_PAYER_EMAIL=
# Cadenas aleatorias largas: protegen el cron diario y la activación manual de planes.
CRON_SECRET=
ADMIN_SECRET=
# Consulta de RUC (por defecto, el servicio gratuito de apis.net.pe).
RUC_API_URL=
RUC_API_TOKEN=
